# Aily 自定义触发器 Bearer Token
FEISHU_AILY_BEARER_TOKEN=replace-me

# 飞书事件订阅 verification token
FEISHU_EVENT_VERIFICATION_TOKEN=replace-me

# 可选：多维表格写回
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-me
FEISHU_BITABLE_APP_TOKEN=bas_xxx
FEISHU_BITABLE_TABLE_ID=tbl_xxx

# Planner Agent（任意 OpenAI-compatible Chat Completions 服务）
# 豆包方舟示例：https://ark.cn-beijing.volces.com/api/v3
SCHEDULE_LLM_API_KEY=replace-me
SCHEDULE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SCHEDULE_LLM_MODEL=replace-with-endpoint-id
SCHEDULE_LLM_TIMEOUT=20
# true：模型失败时阻止请求；false：自动使用有限规则解析器
SCHEDULE_LLM_REQUIRED=false
